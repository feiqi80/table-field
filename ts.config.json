{
    "extends": "@vue/tsconfig/tsconfig.web.json",
    "compilerOptions": {
      "outDir": "dist",
      "sourceMap": true,
      "declaration": true,
      "declarationDir": "dist/types",
      "lib": ["ESNext", "DOM"],
      "paths": {
        "@/*": ["./src/*"]
      }
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "examples/**/*.ts"],
    "exclude": ["node_modules"]
  }